{
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug B⋅LAIR",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/target/debug/blair",
            "env": {},
            "preLaunchTask": "rust: cargo build",
            "args": [],
            "sourceMap": {},
            "sourceLanguages": [
                "rust"
            ],
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "serverReadyAction": {
                "pattern": "Ready! c:",
                "action": "startDebugging",
                "name": "Preview B⋅LAIR",
                "killOnServerStop": true,
            }
        },
        {
            "type": "editor-browser",
            "request": "launch",
            "name": "Preview B⋅LAIR",
            "url": "http://127.0.0.1:8064",
        },
    ]
}